APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lawfirm
DB_USERNAME=root
DB_PASSWORD=

# §3.3/§6: only needed when actually running the migration verification
# suite (`php artisan test --testsuite=Migration`) against the real
# pre-migration database during the migration event. Leave blank
# otherwise — the 'source' connection is never opened unless that suite
# runs.
DB_SOURCE_HOST=
DB_SOURCE_PORT=3306
DB_SOURCE_DATABASE=
DB_SOURCE_USERNAME=
DB_SOURCE_PASSWORD=

# §3.3: absolute path to the document checksum manifest produced by
# Phase 1's export (see MigrateExportDocumentChecksums command).
MIGRATION_CHECKSUM_MANIFEST_PATH=


BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ENG-6: backup:run destination. Local by default for development;
# production MUST set BACKUP_DISK=s3 (backups on the same server/disk as
# the database are not a backup against server loss — see
# docs/ops/BACKUP_STRATEGY.md).
BACKUP_DISK=backups
BACKUP_RETENTION_DAYS=30

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

TEXTSMS_URL=https://sms.textsms.co.ke/api/services/sendsms/
TEXTSMS_API_KEY=
TEXTSMS_PARTNER_ID=
TEXTSMS_SHORTCODE=

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:8000

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
